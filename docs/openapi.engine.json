    "/v1/web/continuation": {
      "post": {
        "operationId": "engineContinuation",
        "summary": "Offer, replay, then acknowledge saved Web activity through Telegram",
        "security": [
          {
            "internalHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "telegram_chat_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "source_user_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "character_i": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32767
                  },
                  "confirm": {
                    "type": "boolean"
                  },
                  "acknowledge": {
                    "type": "boolean"
                  },
                  "scene_session_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "turn_no": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "telegram_chat_id",
                  "source_user_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "none",
                        "offer",
                        "continue"
                      ]
                    },
                    "telegram_chat_id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "acknowledged": {
                      "type": "boolean"
                    },
                    "chat_id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "chat_code": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "character_i": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "scene_session_id": {
                      "type": "string"
                    },
                    "scene_mode": {
                      "type": "string"
                    },
                    "turn_no": {
                      "type": "integer"
                    },
                    "assistant_text": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "callback_data": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "action",
                    "telegram_chat_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Rejected request",
            "content": {
