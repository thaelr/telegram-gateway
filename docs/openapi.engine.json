    "/v1/web/media-offer": {
      "post": {
        "operationId": "engineMediaOffer",
        "summary": "Evaluate existing Commerce policy and persist a source-aware Web offer",
        "security": [
          {
            "internalHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chat_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "sku": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "media_signature": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "media_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "scene_session_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "debounce_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "chat_id",
                  "sku",
                  "media_signature"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "offered": {
                      "type": "boolean"
                    },
                    "has_media_offer": {
                      "type": "boolean"
                    },
                    "media_signature": {
                      "type": "string"
                    },
                    "price_required": {
                      "type": "number"
                    },
                    "media_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "media_kind": {
                      "type": "string",
                      "enum": ["photo"]
                    }
                  },
                  "required": [
                    "offered",
                    "has_media_offer"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Rejected request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
