{
  "openapi": "3.1.0",
  "info": {
    "title": "Midnight Persona internal n8n bridge",
    "version": "1.0.0",
    "description": "Server-to-server routes mounted when Web Commerce is enabled. A browser Supabase bearer is not accepted. No generative prompts or provider keys are returned."
  },
  "components": {
    "securitySchemes": {
      "internalHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-api-key",
        "description": "Header name follows INTERNAL_API_KEY_HEADER; value is the existing INTERNAL_API_KEY. Configure the same n8n header credential."
      }
    }
  },
  "paths": {
    "/v1/web/engine-context": {
      "post": {
        "operationId": "engineContext",
        "summary": "Read canonical chat context",
        "security": [
          {
            "internalHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chat_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "chat_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chat_id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "chat_code": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "character_i": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "scene_session_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "turn_no": {
                      "type": "integer"
                    },
                    "scene_turn_no": {
                      "type": "integer"
                    },
                    "debounce_revision": {
                      "type": "integer"
                    },
                    "scene_mode": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "fast",
                        "roleplay",
                        null
                      ]
                    },
                    "telegram_chat_id": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "chat_id",
                    "chat_code",
                    "user_id",
                    "character_i",
                    "scene_session_id",
                    "turn_no",
                    "scene_turn_no",
                    "debounce_revision",
                    "scene_mode",
                    "telegram_chat_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Rejected request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Rejected request",
